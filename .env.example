# Copy to .env.local. Never commit real credentials.
MONGODB_URI=
MONGODB_DB=studydesk
# Use the exact origin opened in your browser. Both loopback origins are trusted in development.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate a random secret with at least 32 characters. Keep it stable between restarts.
BETTER_AUTH_SECRET=
